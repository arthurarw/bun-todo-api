{
  "name": "bun-todo-api",
  "version": "1.0.0",
  "description": "API RESTful de Todo List com Bun, Express e SQLite",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "start": "bun run dist/server.js",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:init": "bun run scripts/init-db.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.3",
    "uuid": "^11.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2"
  }
}
